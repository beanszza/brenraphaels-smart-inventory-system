# PostgreSQL connection used by the Next.js API routes (server-side secret).
DATABASE_URL="postgresql://user:password@localhost:5432/scms"

# Portal origin for IMS sign-in (setup contract; consumed by the auth work in #5).
PORTAL_URL=https://portal.example.com
# Portal System name, always IMS.
PORTAL_SYSTEM_NAME=IMS
# One-time iss_ backend secret from Portal system:register (server-side only).
PORTAL_SYSTEM_SECRET=
# This deployment's public origin; its /api/portal/callback must be registered.
IMS_APP_URL=https://br-sims.vercel.app
# Operator helper for registering the local HTTPS callback; local runs use this as IMS_APP_URL.
IMS_LOCAL_APP_URL=https://localhost:3003
# Development-only fully permitted Staff bypass (#5); refuse in production, Vercel or off localhost.
IMS_DEV_BYPASS=false
# Gateway origin for audit, files and notifications (setup contract; consumed by gateway work).
IMS_GATEWAY_URL=https://api-gateway.jude-nitram08.workers.dev
# Server-only bearer key for Caller ims, whose auditKey has write:IMS scope.
IMS_GATEWAY_CALLER_KEY=
# Server-only bearer key for Caller ims-audit-read, whose auditKey has read:admin scope (logs page only).
IMS_GATEWAY_AUDIT_READ_CALLER_KEY=

# Legacy auth proxy origin, still needed until cleanup ticket #7 removes it.
AUTH_API_URL="http://localhost:5007"
# Legacy sign-in page origin, still needed until #7 (must match the current dev HTTPS address).
NEXT_PUBLIC_HOST_URL="http://localhost:3000"
# Public CRMS address for the legacy system switcher.
NEXT_PUBLIC_CRMS_URL="http://localhost:3001"
# Public HRMS address for the legacy system switcher.
NEXT_PUBLIC_HRMS_URL="http://localhost:3002"
# Public POS address for the legacy system switcher.
NEXT_PUBLIC_POS_URL="http://localhost:3003"
# Public IMS address for the legacy system switcher (legacy variable name).
NEXT_PUBLIC_SCMS_URL="http://localhost:3004"
# Legacy image backend origin used by lib/getImageUrl.ts until the file resolver replaces it.
NEXT_PUBLIC_API_URL="http://localhost:5001"
# Public storefront address supplied by the existing CI workflow.
NEXT_PUBLIC_OOS_URL="http://localhost:3004"
# Legacy NextAuth signing secret supplied by CI; removed with the unused dependency in #7.
NEXTAUTH_SECRET=
# Legacy NextAuth origin supplied by CI; removed with the unused dependency in #7.
NEXTAUTH_URL="http://localhost:3004"
